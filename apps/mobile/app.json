{
  "expo": {
    "name": "Freshness Tracker",
    "slug": "freshness-tracker-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "freshnesstracker",
    "userInterfaceStyle": "automatic",
    "ios": {
      "infoPlist": {
        "NSCameraUsageDescription": "Freshness Tracker uses the camera to scan food labels.",
        "NSPhotoLibraryUsageDescription": "Freshness Tracker reads photos so you can scan a food label from your library.",
        "NSLocalNetworkUsageDescription": "Freshness Tracker talks to the freshness API running on your computer over Wi-Fi.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      },
      "bundleIdentifier": "com.minhpham.freshnesstracker"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFD93D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFD93D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Freshness Tracker to access your photos to scan food labels.",
          "cameraPermission": "Allow Freshness Tracker to use the camera to scan food labels."
        }
      ],
      "./plugins/with-script-sandbox-disabled"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}
