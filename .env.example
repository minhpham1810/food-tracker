FRESHNESS_DATA_DIR=./data
FRESHNESS_DB_PATH=./data/freshness.sqlite3
# P4 artifact: rmse is the held-out temporal prediction error, not baseline noise.
GAS_CALIBRATION_PATH=./data/gas_calibration.json
# Disabled for the demo: gas and label scores have no influence on item estimates.
ENABLE_EXPERIMENTAL_FUSION=false

# Local LLM gateway (any OpenAI-compatible tool-calling server).
# Defaults below target Ollama on this machine; the model must have the "tools"
# capability (check with: ollama show <model>).
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen3.5:9b
# Ollama ignores auth; leave blank unless your server requires a bearer token.
LLM_API_KEY=

# Food-label scanning uses the same local Qwen model through Ollama's multimodal API.
# OCR_ENGINE=tesseract remains available for legacy single-photo development only;
# Qwen scans do not silently fall back when the model is unavailable.
OCR_ENGINE=qwen
OCR_BASE_URL=http://127.0.0.1:11434
OCR_MODEL=qwen3.5:9b
OCR_TIMEOUT_SECONDS=60
OCR_KEEP_ALIVE=10m

# Deprecated aliases, still read if the LLM_* names above are unset:
# OMLX_BASE_URL / OMLX_MODEL / OMLX_API_KEY

# Live fridge telemetry from the BME688 ThingSpeak channel. Leave the channel id
# blank to run without it (demo scenarios and POST /api/telemetry still work).
THINGSPEAK_CHANNEL_ID=
THINGSPEAK_READ_API_KEY=
THINGSPEAK_POLL_SECONDS=15
